modules = ["nodejs-20", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["SDL2", "SDL2_image", "SDL2_mixer", "SDL2_ttf", "arrow-cpp", "c-ares", "cacert", "cargo", "chromedriver", "fftw", "firefox", "freefont_ttf", "freetype", "geckodriver", "glibcLocales", "glpk", "grpc", "gsl", "hdf5", "lcms2", "libGL", "libGLU", "libcxx", "libffi", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libyaml", "llvm", "mtdev", "nodejs", "openblas", "openjpeg", "openssh", "openssl", "pgadmin4", "pkg-config", "postgresql", "rustc", "scrot", "suitesparse", "tcl", "tk", "xcodebuild", "xdg-utils", "xsimd", "xvfb-run", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "flask_dashboard"

[[workflows.workflow]]
name = "flask_dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py --web --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 40603
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["python", "main.py", "--web", "--port", "5000"]
